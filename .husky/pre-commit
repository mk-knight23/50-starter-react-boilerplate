#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Running pre-commit checks..."

# Type check
echo "Type checking..."
npm run type-check || exit 1

# Lint
echo "Linting..."
npm run lint || exit 1

# Run tests (if any exist)
if [ -d "src" ] && [ -n "$(find src -name '*.test.ts*' -o -name '*.spec.ts*' 2>/dev/null)" ]; then
  echo "Running tests..."
  npm run test -- --run || exit 1
fi

echo "Pre-commit checks passed!"
